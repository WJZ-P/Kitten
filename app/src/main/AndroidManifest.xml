<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        必须在这里声明，`pm grant` 才授得了——它只能授予应用已经声明过的权限。
        这个权限的 protectionLevel 带 development 标志，所以普通应用可以通过
        ADB 拿到；拿到后是永久的，扛重启，也不需要特权进程在场。
        tools:ignore 是因为 lint 默认不允许应用声明受保护权限。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 开机后自动重建特权链路，见 BootCompletedReceiver。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        看得见设备上装了哪些应用。

        Android 11 起的 package visibility 默认只让应用看到一部分邻居：实测 shell
        身份能看到 494 个包，Kitten 自己只能看到 472 个，差的那些连
        `getApplicationInfo()` 都会抛 NameNotFoundException——结果就是节点树的页头
        里只有 `pkg=tv.danmaku.bili`，拿不到"哔哩哔哩"这个名字。

        为什么用它而不是逐个声明 <queries>：Agent 要操作的是**任意**应用，没法预先
        列举。后续"列出可启动应用让用户选"、把"打开淘宝"映射到包名，也都是 app 侧
        UI 的事，为此每次走 AIDL 问特权进程太绕。

        还有一条路是让特权进程代查——它跑在 shell 身份下不受限。留作后备，没有采用。

        需要留意的两点：
        - 上架 Google Play 要提交使用理由说明，以 GitHub / F-Droid 方式分发不受影响；
        - lint 默认拦这个权限，所以要 tools:ignore。相比 Kitten 已经持有的
          WRITE_SECURE_SETTINGS、无障碍（能读任意应用的全部界面内容）和 ADB 特权，
          "知道装了哪些应用"算不上敏感，但它仍然是个要向用户讲清楚的权限。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />

    <!--
        Agent 执行任务时要挂一条常驻通知（见 AgentForegroundService）：进程不会在用户切走
        之后被系统收走，用户也能看到进度、随时喊停。

        privilege 模块也声明了这三个（配对通知要用），清单合并后本来就有；这里再写一遍是
        因为 app 侧自己也在用——哪天 privilege 模块被拆走，这边不该跟着失效。

        POST_NOTIFICATIONS 是运行时权限。没授予时前台服务照常跑，只是那条通知看不见，
        用户也就失去了"停止"按钮，所以界面上该引导用户开。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kitten">

        <!--
            只听 BOOT_COMPLETED，不听 LOCKED_BOOT_COMPLETED，也不标 directBootAware。
            这是有意的：ADB 密钥存在 filesDir（凭据加密存储），用户解锁前根本读不到，
            解锁前跑这个广播只会误报"从没配对过"然后白跑一趟。

            Shizuku 走的是另一条路——把密钥放进 createDeviceProtectedStorageContext()，
            于是解锁前也能恢复。我们不跟：ADB 私钥等同于设备的 shell 权限，不该为了
            早几秒就扔进"无需用户凭据即可解密"的存储里。反正解锁前助手也干不了事。
        -->
        <receiver
            android:name=".boot.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.KittenAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            Agent 跑任务时的常驻通知宿主。用 specialUse 而不是 shortService，理由和配对
            服务一样：shortService 在 API 34+ 有 3 分钟硬超时，到点不停会 ANR，而"在应用里
            翻到历史订单再下单"这类任务跑几分钟很正常。
        -->
        <service
            android:name=".service.AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="agent_task" />
        </service>

        <service
            android:name=".service.KittenNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
